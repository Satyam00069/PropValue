# PropValue AI Environment Variables

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="PropValue AI"
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeychangethisinproduction_min32charslong
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production: postgresql+psycopg2://postgres:postgres@localhost:5432/propvalue_ai
# Local development fallback: sqlite:///./propvalue.db
DATABASE_URL=sqlite:///./propvalue.db

# Redis Caching (Optional, in-memory cache used when not configured)
REDIS_URL=redis://localhost:6379/0

# Geospatial & Map settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# External Data Providers (Optional credentials for real external ingestion)
MAHARERA_API_KEY=
MAHARASHTRA_IGR_API_KEY=
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

